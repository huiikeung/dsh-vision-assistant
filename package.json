{
  "name": "dsh-vision-assistant",
  "version": "0.4.0",
  "type": "module",
  "main": "lib/index.js",
  "description": "DeepSeek Harness plugin (集成版): 设置侧栏「视觉助手」——上半区管理已配置的视觉模型（只显示声明支持图片的模型），下半区管理免费视觉渠道（免 Key OVHcloud 兜底 + 渠道级密钥 + 多 key 轮换 + 免费链路自动降级）。整合 dsh-vision-router 与 ModLens 的能力。",
  "license": "MIT",
  "engines": {
    "node": ">=20.3"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "vision",
    "multimodal",
    "ocr",
    "free-models",
    "plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-skill": ">=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "tests"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
